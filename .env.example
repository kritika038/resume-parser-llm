# ======================================================================
# AI RESUME INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ======================================================================
# Copy this file to '.env' and populate with your credentials.
# ======================================================================

# 🔀 Active LLM Provider Configuration
# Supported options:
# - 'ollama' : Runs completely offline using local Mistral-7B models (Default)
# - 'groq'   : Runs at hyper-speed using Groq Cloud Serverless LPUs
LLM_PROVIDER=ollama

# ======================================================================
# 1. CLOUD INFERENCE CONFIGURATION (Required only if LLM_PROVIDER=groq)
# ======================================================================
# Create your Groq API token at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_goes_here

# The active model deployment to target on Groq.
# High-speed options: 'llama-3.1-8b-instant' (Default), 'mixtral-8x7b-32768'
GROQ_MODEL=llama-3.1-8b-instant

# ======================================================================
# 2. LOCAL OFFLINE CONFIGURATION (Used if LLM_PROVIDER=ollama)
# ======================================================================
# The connection URL to your locally running Ollama server instance
OLLAMA_API_URL=http://localhost:11434/api/generate

# The target model downloaded on your local Ollama server
OLLAMA_MODEL=mistral

# Request timeout limit in seconds for local model processing
OLLAMA_TIMEOUT=90
